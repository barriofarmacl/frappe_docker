# =============================================================================
# Variables de Entorno - PoC Arquitectura Hibrida
# =============================================================================
# Copiar este archivo a .env.hybrid y configurar los valores
# Uso: docker compose -f docker-compose.hybrid-poc.yml --env-file .env.hybrid up
# =============================================================================

# -----------------------------------------------------------------------------
# Cloud SQL Configuration (REQUERIDO)
# -----------------------------------------------------------------------------
# Host de la BD (IP o FQDN). Cloud SQL: terraform output database_public_ip. MariaDB Cloud: ver "Connect" en el servicio.
CLOUD_SQL_IP=35.222.68.184

# Puerto (Cloud SQL: 3306. MariaDB Cloud Serverless: suele ser 4051 u otro segun el modal "Connect".)
DB_PORT=3306

# Credenciales. MariaDB Cloud: usuario y password del modal "Connect" (no es root).
CLOUD_SQL_USER=root
CLOUD_SQL_PASSWORD=bfdb123
CLOUD_SQL_DATABASE=barriofarma

# MariaDB Cloud (SkySQL): el usuario administrador no tiene GRANT (error 1044).
# Poner a 1 para usar el mismo usuario para el sitio (solo CREATE DATABASE, sin CREATE USER/GRANT).
# Requiere montar scripts/patch_mariadb_cloud_setup_db.py (ya incluido en el compose).
# MARIADB_CLOUD_USE_ROOT_FOR_SITE=1

# Connection name (para Cloud SQL Proxy si se usa)
# Obtener con: terraform output database_connection_name
CLOUD_SQL_INSTANCE=barriofarma:us-central1:barriofarma-hybrid-poc-db

# -----------------------------------------------------------------------------
# Frappe/ERPNext Configuration
# -----------------------------------------------------------------------------
# Imagen de Frappe a usar
FRAPPE_IMAGE=bf-app-dev:0.0.1-otel

# Puerto local para acceder a la aplicacion
FRAPPE_PORT=8080

# Host del sitio (usado por Frappe para URLs y cabecera Host)
# Por defecto: localhost. Para acceder por IP (ej. desde otra maquina en la red):
# SITE_HOST=192.168.1.100  (reemplazar por la IP de esta maquina)
# SITE_HOST=

# -----------------------------------------------------------------------------
# Observabilidad (Opcional)
# -----------------------------------------------------------------------------
# Endpoint de OpenTelemetry Collector (dejar vacio si no se usa)
OTEL_ENDPOINT=

# -----------------------------------------------------------------------------
# Certificados SSL (Opcional - para conexion segura)
# -----------------------------------------------------------------------------
# Los certificados deben estar en ./certs/
# - server-ca.pem
# - client-cert.pem
# - client-key.pem
#
# Descargar con los comandos de: terraform output ssl_cert_download_commands
