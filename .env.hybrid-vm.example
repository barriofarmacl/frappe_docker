# =============================================================================
# Variables de Entorno - PoC POC-002 (MariaDB en GCE VM)
# =============================================================================
# Copiar a .env.hybrid-vm y configurar con: terraform output mariadb_public_ip
# Uso: docker-compose -f docker-compose.hybrid-poc-vm.yml --env-file .env.hybrid-vm up
# =============================================================================

# -----------------------------------------------------------------------------
# MariaDB en GCE VM (REQUERIDO)
# -----------------------------------------------------------------------------
# IP publica de la VM. Obtener con: cd terraform/hybrid-poc-vm && terraform output mariadb_public_ip
CLOUD_SQL_IP=

# Puerto estandar MariaDB
DB_PORT=3306

# Credenciales (mismo db_password usado en Terraform)
CLOUD_SQL_USER=root
CLOUD_SQL_PASSWORD=bfdb123
CLOUD_SQL_DATABASE=barriofarma

# -----------------------------------------------------------------------------
# Frappe/ERPNext
# -----------------------------------------------------------------------------
FRAPPE_IMAGE=bf-app-dev:0.0.1-otel
FRAPPE_PORT=8080
SITE_HOST=

# -----------------------------------------------------------------------------
# Observabilidad (Opcional)
# -----------------------------------------------------------------------------
OTEL_ENDPOINT=

# -----------------------------------------------------------------------------
# Certificados SSL (Opcional)
# -----------------------------------------------------------------------------
# Para conexion TLS a la VM: server-ca.pem, client-cert.pem, client-key.pem en ./certs/
# La VM POC-002 por defecto acepta conexiones sin TLS; SSL se puede configurar despues.
