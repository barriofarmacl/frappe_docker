apiVersion: v1
kind: ConfigMap
metadata:
  name: barriofarma-config
  namespace: barriofarma
  labels:
    app.kubernetes.io/name: barriofarma
    app.kubernetes.io/component: config
data:
  # Frappe Configuration
  FRAPPE_SITE_NAME: "frontend"
  FRAPPE_SITE_NAME_HEADER: "frontend"
  
  # Redis Configuration (Memorystore)
  # Actualizar con IPs privadas obtenidas de: terraform output redis_cache_host
  FRAPPE_REDIS_CACHE: "redis://redis-cache:6379"  # Reemplazar con IP de Memorystore Redis Cache
  FRAPPE_REDIS_QUEUE: "redis://redis-queue:6379"  # Reemplazar con IP de Memorystore Redis Queue
  
  # Database Configuration (Cloud SQL MariaDB)
  # Actualizar con IP privada obtenida de: terraform output database_private_ip
  DB_HOST: "postgres-service"  # Reemplazar con IP privada de Cloud SQL (ej: "10.123.45.67")
  DB_PORT: "3306"
  DB_TYPE: "mariadb"
  DB_NAME: "barriofarma"
  
  # Observability Configuration
  OTEL_SERVICE_NAME: "barriofarma-backend"
  OTEL_SERVICE_VERSION: "0.0.1-otel"
  OTEL_EXPORTER_OTLP_ENDPOINT: "http://otel-collector:4317"
  OTEL_EXPORTER_OTLP_PROTOCOL: "grpc"
  
  # Logging Configuration
  LOG_LEVEL: "INFO"
  LOG_FORMAT: "json"
  
  # Metrics Configuration
  METRICS_ENABLED: "true"
  METRICS_PORT: "9090"
