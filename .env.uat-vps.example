# Imagen del bench publicada en un registry accesible desde la VPS
APP_IMAGE=gcr.io/barriofarma-uat-cl/bf-app-uat:0.0.7-uat

# Identidad del sitio UAT
SITE_NAME=frontend
SITE_HOSTNAME=uat.example.com
SITE_PROTOCOL=https
SITE_USE_SSL=1
SITE_SOCKETIO_PORT=443

# Credenciales sensibles: usar Ansible Vault o un archivo local no versionado
SITE_ADMIN_PASSWORD=change-me
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=change-me
SITE_DB_PASSWORD=

# Apps que debe instalar create-site (UAT 2.0: incluye pagosbf)
INSTALL_APPS=erpnext barriofarma_app pagosbf

# Binds locales de la VPS (se publican a traves de nginx host-level)
FRONTEND_BIND_PORT=18080
DB_LOCAL_PORT=13307

# Reverse proxy / TLS
TLS_EMAIL=eduardo.araya@barriofarma.cl
